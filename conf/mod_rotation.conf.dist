#
# mod-rotation — configuration
# Automatically copied to configs/modules/mod_rotation.conf at build time.
# Reloadable in-game with the GM command: .reload config
#

[worldserver]

#
#    Rotation.Enable
#        Description: Enables or disables the module.
#        Default: 1
#

Rotation.Enable = 1

#
#    Rotation.SpellId
#        Description: ID of the trigger spell (the "Rotation" spell on the
#                     action bar). Must exist in the client's Spell.dbc, be
#                     instant, cost nothing and have no disruptive effect.
#        Default: 47322 ("Dragonblight Test Spell 02": instant, no cost,
#                     no cooldown, no GCD, harmless Dummy effect)
#        Tested alternative: 40019 ("Birmingham Tools Test" — plays a
#                     "ZombieAggro" sound on every press)
#

Rotation.SpellId = 47322

#
#    Rotation.AutoLearn
#        Description: Automatically teaches the trigger spell to every player
#                     on login (all classes).
#        Default: 1
#

Rotation.AutoLearn = 1

#
#    Rotation.Announce
#        Description: Shows a message to players on login.
#        Default: 0 (disabled)
#

Rotation.Announce = 0

#
#    Rotation.Announce.Message
#        Description: The login message sent when Rotation.Announce is
#                     enabled. Supports WoW color codes (|cffXXXXXX...|r).
#        Default: "One-button |cff4CFF00Rotation|r module active: place the
#                     Rotation spell from your spellbook on your action bar."
#        French example:
#            Rotation.Announce.Message = "Module |cff4CFF00Rotation|r actif : placez le sort Rotation de votre grimoire sur votre barre d'action."
#

Rotation.Announce.Message = "One-button |cff4CFF00Rotation|r module active: place the Rotation spell from your spellbook on your action bar."

#
#    Rotation.AoE.Threshold
#        Description: Number of enemies in melee range from which area
#                     abilities (Whirlwind, Cleave, Consecration, Volley,
#                     Blizzard, Death and Decay…) take priority.
#        Default: 2
#

Rotation.AoE.Threshold = 2

#
#    Rotation.RageDump.Threshold
#        Description: Minimum rage (0-100) before queueing "on next swing"
#                     attacks (Heroic Strike, Cleave, Maul), so the rest of
#                     the rotation is not starved.
#        Default: 50
#

Rotation.RageDump.Threshold = 50

#
#    Rotation.EnergyDump.Threshold
#        Description: Reserved for future use (energy threshold).
#        Default: 60
#

Rotation.EnergyDump.Threshold = 60

#
#    Rotation.Heal.InjuredPct
#    Rotation.Heal.LowPct
#    Rotation.Heal.UrgentPct
#        Description: Health thresholds (in %) used by healing
#                     specializations on the friendly target (or self):
#                       - InjuredPct: below this, maintenance healing (HoTs,
#                         shields, small heals)
#                       - LowPct    : below this, sustained healing
#                       - UrgentPct : below this, emergency healing
#                     Above InjuredPct, healers contribute light damage if an
#                     enemy is targeted.
#        Defaults: 85 / 60 / 35
#

Rotation.Heal.InjuredPct = 85
Rotation.Heal.LowPct = 60
Rotation.Heal.UrgentPct = 35
